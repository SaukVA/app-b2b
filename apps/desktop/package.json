{
  "name": "@app/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Shell de escritorio (Electron) que empaqueta apps/client",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run build --workspace=@app/shared && npm run build --workspace=@app/server && tsc -p tsconfig.build.json",
    "build:renderer": "npm run build --workspace=@app/client && node -e \"const fs=require('node:fs');fs.rmSync('renderer',{recursive:true,force:true});fs.cpSync('../client/dist','renderer',{recursive:true})\"",
    "package": "npm run build && npm run build:renderer && electron-builder",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@app/server": "*",
    "@app/shared": "*"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "es.mayorista.app-b2b",
    "productName": "Venta a mayoristas",
    "electronVersion": "34.5.8",
    "npmRebuild": false,
    "win": {
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "renderer/**"
    ]
  }
}
