{
  "name": "app-b2b",
  "private": true,
  "description": "Aplicación de venta a mayoristas (web + escritorio)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client,desktop -c blue,green,magenta \"npm run dev -w apps/server\" \"npm run dev -w apps/client\" \"npm run dev -w apps/desktop\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "jest": "^30.0.0",
    "prettier": "~3.4.2",
    "ts-jest": "^29.4.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.19.0"
  }
}
