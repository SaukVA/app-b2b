# Plantilla de variables de entorno. Copiar a .env y rellenar; NUNCA commitear .env.

# Puerto HTTP del servidor Express
PORT=4000

# Conexión a MongoDB (docker compose up -d levanta una instancia local en 27017)
MONGODB_URI=mongodb://localhost:27017/wholesale

# Secreto para firmar los access tokens JWT (cadena larga y aleatoria)
JWT_ACCESS_SECRET=<cadena-aleatoria-de-al-menos-32-caracteres>

# Orígenes permitidos por CORS, separados por comas (cliente Vite en dev y escritorio)
CORS_ORIGINS=http://localhost:5173,app://.

# development | production | test
NODE_ENV=development
